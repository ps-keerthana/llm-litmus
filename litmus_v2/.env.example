# LITMUS_V2 Environment Configuration Example
# Copy to .env in your root or litmus_v2/ directory. Never commit .env!

# Optional Groq API Key for Judge or Generator
GROQ_API_KEY=gsk_your_groq_api_key_here

# Local Ollama endpoint (if running locally)
OLLAMA_BASE_URL=http://localhost:11434/v1

# OpenAI API Key (optional)
OPENAI_API_KEY=sk-your_openai_api_key_here

# HuggingFace token for gated models (optional)
HF_TOKEN=hf_your_hf_token_here
