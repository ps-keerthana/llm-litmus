# LLM-Litmus — Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env — it is listed in .gitignore.

# ── Required: LLM Provider API Keys ──────────────────────────────────────────
# At least one provider key is required. Groq is the default.
GROQ_API_KEY=gsk_your_groq_key_here

# Optional: only needed if you use --provider openai
OPENAI_API_KEY=sk-your_openai_key_here

# Optional: only needed if you use --provider anthropic
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here

# ── Optional: Override LLM Provider ──────────────────────────────────────────
# Options: groq | ollama | openai | anthropic  (default: groq)
# LLM_PROVIDER=groq

# ── Optional: Override Model Names ───────────────────────────────────────────
# GROQ_MODEL_NAME=llama-3.3-70b-versatile
# OLLAMA_MODEL_NAME=llama3.2:1b
# OPENAI_MODEL_NAME=gpt-4o-mini
# ANTHROPIC_MODEL_NAME=claude-3-5-haiku-20241022

# ── Optional: Domain Configuration ───────────────────────────────────────────
# EVAL_DOMAIN=general
# EVAL_DOMAIN_DESCRIPTION=General Q&A knowledge base
# EVAL_COLLECTION_NAME=litmus_eval

# ── Optional: Chunking & Retrieval ───────────────────────────────────────────
# CHUNK_STRATEGY=paragraph          # paragraph | sentence | fixed_size
# CHROMA_PERSISTENT=false           # Set true to persist ChromaDB to disk

# ── Optional: API Server Security ────────────────────────────────────────────
# API_KEY=your_api_server_key_here  # Required to call /runs/enqueue in production
# ALLOWED_ORIGINS=http://localhost:8501,http://localhost:3000

# ── Optional: Ensemble Judge ─────────────────────────────────────────────────
# JUDGE_ENSEMBLE=false              # Set true to enable multi-model judging
